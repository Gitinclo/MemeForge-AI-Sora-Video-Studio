# ==============================================================================
# MemeForge AI & LEO Video Studio - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your values for local development:
#   cp .env.example .env
#
# CRITICAL NOTICE: Never commit your actual '.env' file containing real secret keys
# to version control. Keep all production credentials strictly in environment secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Credentials
# ------------------------------------------------------------------------------
# Required for multimodal meme image analysis (Gemini 3.8 Flash), prompt expansion
# (Gemini 3.1 Flash Lite), and comedy co-director chat (Gemini 4 Argon).
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 2. Server & Network Configuration
# ------------------------------------------------------------------------------
# PORT: Local Express server listening port (default: 3000)
PORT=3000

# NODE_ENV: Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# APP_URL: Public or local hosting origin URL
# In AI Studio, this is automatically injected with the Cloud Run service URL.
# Used for PWA service workers, share links, and UPI callback routing.
APP_URL="http://localhost:3000"
